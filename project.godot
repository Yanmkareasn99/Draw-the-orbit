; Import this file in Godot 4.4 or newer (standard edition).
config_version=5

[application]
config/name="Draw the Orbit — Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.075, 1)
