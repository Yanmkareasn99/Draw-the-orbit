extends SceneTree

const Route = preload("res://scripts/route.gd")
const Game = preload("res://scripts/game.gd")
var failures := 0
var checks := 0

func check(condition: bool, title: String) -> void:
	checks += 1
	if condition:
		print("PASS: ", title)
	else:
		push_error(title)
		failures += 1

func hazard(pos: Vector2, vel: Vector2, redirected: bool = false, warmup: float = 0.0) -> Dictionary:
	return {"pos": pos, "vel": vel, "radius": 9.0, "warmup": warmup, "redirected": redirected, "recovery": Game.UFO_RECOVERY_TIME if redirected else 0.0}

func activate(game: Node, points: PackedVector2Array) -> void:
	game.sketch = points.duplicate()
	game.finish_sketch()

func arc_points(center: Vector2, start_degrees: float, end_degrees: float) -> PackedVector2Array:
	var points := PackedVector2Array()
	for i in range(61):
		points.append(center + Vector2.from_angle(deg_to_rad(lerpf(start_degrees, end_degrees, i / 60.0))) * 100.0)
	return points

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var line := PackedVector2Array([Vector2(250,120), Vector2(250,350)])
	check(is_equal_approx(Route.length_of(line), 230), "barrier length")
	check(Route.validate_barrier(line, Vector2(465,410), 58, 1550) == "", "open two-point barrier accepted")
	check(Route.validate_barrier(PackedVector2Array([Vector2.ZERO]), Vector2(465,410), 58, 1550) != "", "single-point sketch rejected")
	check(Route.validate_barrier(PackedVector2Array([Vector2.ZERO, Vector2(10,0)]), Vector2(465,410), 58, 1550) != "", "tiny sketch rejected")
	check(Route.validate_barrier(line, Vector2(250,200), 58, 1550) != "", "planet crossing rejected")
	check(Route.validate_barrier(line, Vector2(465,410), 58, 100) != "", "length budget enforced")
	var bow := PackedVector2Array([Vector2(0,0),Vector2(100,100),Vector2(0,100),Vector2(100,0)])
	check(Route.validate_barrier(bow, Vector2(500,500), 58, 1550) != "", "open self-crossing barrier rejected")
	var box := PackedVector2Array([Vector2(180,150),Vector2(280,150),Vector2(280,300),Vector2(180,300),Vector2(180,150)])
	check(Route.validate_barrier(box, Vector2(465,410), 58, 1550) == "", "closed barriers also accepted")
	var game = load("res://main.tscn").instantiate()
	root.add_child(game)
	game.set_physics_process(false)
	var c: Vector2 = game.CENTER
	var ring := PackedVector2Array([c + Vector2(-100,-100), c + Vector2(100,-100), c + Vector2(100,100), c + Vector2(-100,100), c + Vector2(-100,-100)])
	var open_arc := arc_points(c, 40.0, 320.0)
	check(not Route.planet_is_enclosed([], c), "no barriers leave planet open")
	check(Route.planet_is_enclosed([ring], c), "closed planet shield blocks all approaches")
	var reverse_ring := ring.duplicate()
	reverse_ring.reverse()
	check(Route.planet_is_enclosed([reverse_ring], c), "enclosure detection works in either drawing direction")
	var almost_ring := ring.duplicate()
	almost_ring[-1] += Vector2(0,20)
	check(not Route.planet_is_enclosed([almost_ring], c), "gap narrower than UFO clearance is allowed")
	check(not Route.planet_is_enclosed([open_arc], c), "open curve is allowed across angle wraparound")
	check(not Route.planet_is_enclosed([arc_points(c, 130.0, 410.0)], c), "gap acceptance is independent of rotation")
	check(not Route.planet_is_enclosed([arc_points(c, 0.0, 359.9)], c), "even a very narrow gap is allowed")
	check(not Route.planet_is_enclosed([box], c), "closed trap away from planet remains allowed")
	game.start_round()
	game.sketch = ring.duplicate()
	check(game.sketch_error() == "Leave a gap", "enclosing sketch shows a concise gap warning before release")
	game.finish_sketch()
	check(game.barriers.is_empty() and game.redraws == 0 and is_equal_approx(game.available_ink(), game.BUDGET), "enclosing shield is rejected without charging ink")
	activate(game, almost_ring)
	check(game.barriers.size() == 1 and game.barriers[0].points == almost_ring, "almost closed shield activates when it leaves a gap")
	game.start_round()
	var tiny_gap := ring.duplicate()
	tiny_gap[-1] += Vector2(0, 0.01)
	activate(game, tiny_gap)
	check(game.barriers.size() == 1, "no minimum gap size is imposed on release")
	game.start_round()
	var first_half := PackedVector2Array([ring[0],ring[1],ring[2]])
	var second_half := PackedVector2Array([ring[2],ring[3],ring[4]])
	activate(game, first_half)
	var ink_before: float = game.available_ink()
	activate(game, second_half)
	check(game.barriers.size() == 1 and game.barriers[0].points == first_half and is_equal_approx(game.available_ink(), ink_before), "separate strokes cannot jointly enclose planet or spend rejected ink")
	game.step_world(5.0)
	activate(game, second_half)
	check(game.barriers.size() == 1 and game.barriers[0].points == second_half, "expired barriers no longer count against the planet opening")
	game.start_round()
	activate(game, PackedVector2Array([c + Vector2(-120,-100), c + Vector2(120,-100)]))
	activate(game, PackedVector2Array([c + Vector2(100,-120), c + Vector2(100,120)]))
	activate(game, PackedVector2Array([c + Vector2(-120,100), c + Vector2(120,100)]))
	activate(game, PackedVector2Array([c + Vector2(-100,-120), c + Vector2(-100,120)]))
	check(game.barriers.size() == 3 and game.message == "Leave a gap", "intersecting strokes cannot assemble a planet enclosure")
	game.start_round()
	activate(game, first_half)
	var gapped_half := second_half.duplicate()
	gapped_half[-1] += Vector2(0, 1)
	activate(game, gapped_half)
	check(game.barriers.size() == 2, "separate strokes can surround the planet while leaving a small gap")
	var gap_ink: float = game.available_ink()
	activate(game, PackedVector2Array([ring[0] + Vector2(0, -12), ring[0] + Vector2(0, 14)]))
	check(game.barriers.size() == 2 and is_equal_approx(game.available_ink(), gap_ink), "collinear overlapping stroke that seals the final gap is rejected")
	game.start_round()
	var outer_arc := arc_points(c, 200.0, 520.0)
	for i in range(outer_arc.size()):
		outer_arc[i] = c + (outer_arc[i] - c) * 1.5
	activate(game, arc_points(c, 20.0, 340.0))
	activate(game, outer_arc)
	check(game.barriers.size() == 2, "staggered gaps remain valid even when walls cover every straight approach")
	game.start_round()
	activate(game, open_arc)
	check(game.barriers.size() == 1, "open defensive arc still activates")
	game.hazards.append(hazard(c + Vector2(200,0), Vector2(-40,0)))
	game.step_world(4.0)
	check(game.health == 4 and game.barriers.size() == 1, "UFO can reach planet through the required opening while barrier stays active")
	game.start_round()
	check(game.barriers.is_empty(), "round starts without automatic defense")
	game.sketch = line.duplicate()
	game.finish_sketch()
	check(game.barriers.size() == 1 and game.barriers[0].points == line and game.redraws == 1, "release activates open barrier")
	game.sketch = PackedVector2Array([Vector2(100,200)])
	game.finish_sketch()
	check(game.barriers.size() == 1 and game.barriers[0].points == line and game.redraws == 1, "invalid sketch preserves active barrier")
	game.hazards.append(hazard(Vector2(230,200), Vector2(100,0)))
	game.step_world(0.2)
	check(game.hazards.size() == 1 and game.hazards[0].vel.is_equal_approx(Vector2(-100,0)) and game.hazards[0].redirected, "face collision reflects and arms hazard")
	check(game.hazards[0].pos.x < 239 and game.score == 0, "bounce separates hazard without destroying or scoring")
	game.step_world(0.1)
	check(game.hazards[0].vel.x < 0, "departing hazard does not bounce again on same face")
	game.start_round()
	activate(game, line.duplicate())
	game.hazards.append(hazard(Vector2(270,200), Vector2(-100,0)))
	game.step_world(0.2)
	check(game.hazards[0].vel.is_equal_approx(Vector2(100,0)), "barrier reflects from either side")
	game.start_round()
	activate(game, PackedVector2Array([Vector2(200,150),Vector2(350,300)]))
	game.hazards.append(hazard(Vector2(260,190), Vector2(0,100)))
	game.step_world(0.2)
	check(game.hazards[0].vel.distance_to(Vector2(100,0)) < 0.01, "45 degree barrier aims rebound sideways")
	var overlap := hazard(Vector2(260,210), Vector2(0,100))
	game.reflect_hazard(overlap)
	check(overlap.redirected and overlap.vel.distance_to(Vector2(100,0)) < 0.01 and overlap.pos.distance_to(Route.nearest(game.barriers[0].points, overlap.pos).point) > 11.0, "barrier drawn through hazard uses its angle and separates contact")
	game.start_round()
	activate(game, PackedVector2Array([Vector2(250,200),Vector2(250,300)]))
	game.hazards.append(hazard(Vector2(230,194), Vector2(100,0)))
	game.step_world(0.2)
	check(game.hazards[0].redirected and game.hazards[0].vel.y < 0 and is_equal_approx(game.hazards[0].vel.length(), 100), "rounded endpoint reflects without changing speed")
	game.start_round()
	activate(game, box.duplicate())
	game.hazards.append(hazard(Vector2(230,220), Vector2(100,0)))
	game.step_world(2.0)
	check(game.hazards.size() == 1 and game.hazards[0].pos.x > 190 and game.hazards[0].pos.x < 270 and is_equal_approx(game.hazards[0].vel.length(), 100), "repeated rebounds remain separated and preserve speed")
	game.start_round()
	activate(game, line.duplicate())
	game.hazards.append(hazard(Vector2(200,200), Vector2(1000,0)))
	game.step_world(0.1)
	check(game.hazards.size() == 1 and game.hazards[0].vel.x < 0 and game.hazards[0].pos.x < 239, "fast hazard cannot tunnel through barrier")
	game.start_round()
	activate(game, line.duplicate())
	game.hazards.append(hazard(Vector2(230,200), Vector2(100,0)))
	game.hazards.append(hazard(Vector2(180,200), Vector2(100,0)))
	game.step_world(0.4)
	check(game.hazards.is_empty() and game.hits == 2 and game.score == 200, "barrier rebound destroys incoming hazard and itself for 200 points")
	game.step_world(0.4)
	check(game.score == 200, "destroyed pair cannot score twice")
	game.start_round()
	game.hazards.append(hazard(Vector2(200,200), Vector2.ZERO))
	game.hazards.append(hazard(Vector2(210,200), Vector2.ZERO))
	game.step_world(0.01)
	check(game.hazards.size() == 2 and game.score == 0, "untouched hazards do not destroy each other")
	game.hazards[1].redirected = true
	game.step_world(0.01)
	check(game.hazards.is_empty() and game.score == 200, "redirected second hazard also triggers pair destruction")
	game.start_round()
	game.hazards.append(hazard(Vector2(200,200), Vector2(1000,0), true))
	game.hazards.append(hazard(Vector2(280,200), Vector2(-1000,0), true))
	game.step_world(0.1)
	check(game.hazards.is_empty() and game.hits == 2, "fast redirected hazards cannot pass through each other")
	game.start_round()
	for i in range(3):
		game.hazards.append(hazard(Vector2(200 + i,200), Vector2.ZERO, true))
	game.step_world(0.01)
	check(game.hazards.size() == 1 and game.score == 200, "three-way overlap consumes each hazard at most once")
	game.start_round()
	activate(game, line.duplicate())
	game.hazards.append(hazard(Vector2(245,200), Vector2(100,0), false, 1.2))
	game.hazards.append(hazard(Vector2(230,200), Vector2.ZERO, true))
	game.step_world(0.1)
	check(game.hazards.size() == 2 and game.hazards[0].pos == Vector2(245,200) and not game.hazards[0].redirected, "spawn warnings neither move, bounce, nor collide")
	game.start_round()
	game.hazards.append(hazard(game.CENTER, Vector2.ZERO, true))
	game.step_world(0.01)
	check(game.health == 4 and game.hazards.is_empty(), "redirected hazards still damage planet if aimed into it")
	game.hazards.append(hazard(Vector2(-10,200), Vector2(-100,0), true))
	game.step_world(0.01)
	check(game.hazards.size() == 1 and game.ARENA.has_point(game.hazards[0].pos) and game.hazards[0].vel.dot(game.CENTER - game.hazards[0].pos) > 0 and game.score == 0, "UFOs at the arena edge turn inward instead of disappearing")
	check(is_equal_approx(game.hazards[0].recovery, 9.99), "arena edge preserves the full ten-second stun timer")
	game.start_round()
	game.spawn_attack()
	check(game.hazards.size() == 2 and game.hazards[0].warmup > 0 and is_zero_approx(game.hazards[0].recovery) and game.hazards[0].vel.normalized().is_equal_approx((game.CENTER - game.hazards[0].pos).normalized()), "alien wave starts with a warning and aims at the planet")
	game.start_round()
	var survivor := hazard(game.CENTER + Vector2(100,0), Vector2(20,0), true)
	game.hazards.append(survivor)
	game.step_world(10.0)
	check(survivor.vel.is_equal_approx(Vector2(20,0)) and is_zero_approx(survivor.recovery), "stunned UFO keeps its rebound trajectory for the full ten seconds")
	game.step_world(0.2)
	check(survivor.vel.dot((game.CENTER - survivor.pos).normalized()) > -20 and absf(survivor.vel.angle()) <= game.UFO_TURN_RATE * 0.2 + 0.001 and is_equal_approx(survivor.vel.length(), 20), "recovered pilot gradually steers toward planet without changing speed")
	game.step_world(20.0)
	check(game.hazards.is_empty() and game.health == 4 and game.score == 0, "surviving redirected UFO returns and damages the planet")
	game.start_round()
	activate(game, line)
	var recovered := hazard(Vector2(240,200), Vector2(100,0), true)
	recovered.recovery = 0.0
	game.reflect_hazard(recovered)
	check(is_equal_approx(recovered.recovery, game.UFO_RECOVERY_TIME) and recovered.vel.x < 0, "another barrier bounce restarts the pilot stun window")
	var partial := hazard(Vector2(200,200), Vector2(-40,0), true)
	partial.recovery = 0.1
	var previous_heading: float = partial.vel.angle()
	game.steer_ufo(partial, 0.2)
	check(is_zero_approx(partial.recovery) and is_equal_approx(absf(angle_difference(previous_heading, partial.vel.angle())), game.UFO_TURN_RATE * 0.1), "recovery ending mid-step only steers for the remaining time")
	game.start_round()
	game.hazards.append(hazard(Vector2(200,200), Vector2.ZERO, true))
	game.hazards[0].recovery = 0.0
	game.hazards.append(hazard(Vector2(210,200), Vector2.ZERO))
	game.step_world(0.01)
	check(game.hazards.is_empty() and game.score == 200, "recovered UFO remains eligible for redirected pair destruction")
	game.start_round()
	var warning := hazard(Vector2(200,200), Vector2(40,0), true, 1.2)
	game.hazards.append(warning)
	game.step_world(0.5)
	check(warning.pos == Vector2(200,200) and is_equal_approx(warning.recovery, game.UFO_RECOVERY_TIME), "spawn warning freezes pilot recovery and flight")
	game.start_round()
	game.elapsed = 89.99
	game._physics_process(0.02)
	check(game.state == "won", "90 second victory")
	game.start_round()
	game.health = 1
	game.hazards.append(hazard(game.CENTER, Vector2.ZERO))
	game.step_world(0.01)
	check(game.state == "lost", "zero integrity ends round")
	game.start_round()
	var second_line := PackedVector2Array([Vector2(350,120), Vector2(350,350)])
	activate(game, line)
	activate(game, second_line)
	check(game.barriers.size() == 2 and is_equal_approx(game.available_ink(), 1090), "multiple barriers coexist and share one length budget")
	game.hazards.append(hazard(Vector2(230,200), Vector2(100,0)))
	game.hazards.append(hazard(Vector2(330,300), Vector2(100,0)))
	game.step_world(0.2)
	check(game.hazards.size() == 2 and game.hazards[0].vel.x < 0 and game.hazards[1].vel.x < 0, "older and newer barriers both reflect hazards")
	game.start_round()
	activate(game, line)
	game.step_world(2.0)
	activate(game, second_line)
	check(is_equal_approx(game.barriers[0].life, 3.0) and is_equal_approx(game.barriers[1].life, 5.0), "each barrier has an independent five-second lifetime")
	game.step_world(2.99)
	check(game.barriers.size() == 2 and is_equal_approx(game.available_ink(), 1090), "barriers retain ink until their lifetime ends")
	game.step_world(0.01)
	check(game.barriers.size() == 1 and game.barriers[0].points == second_line and is_equal_approx(game.available_ink(), 1320), "expiry at five seconds refunds only the expired barrier length")
	game.hazards.append(hazard(Vector2(230,200), Vector2(100,0)))
	game.step_world(0.2)
	check(not game.hazards[0].redirected and game.hazards[0].pos.x > 249, "expired barrier no longer reflects hazards")
	game.hazards.clear()
	game.step_world(1.8)
	check(game.barriers.is_empty() and is_equal_approx(game.available_ink(), game.BUDGET), "last expiry restores the entire budget")
	game.start_round()
	activate(game, PackedVector2Array([Vector2(50,150), Vector2(850,150)]))
	game.step_world(1.0)
	activate(game, PackedVector2Array([Vector2(50,180), Vector2(800,180)]))
	check(is_zero_approx(game.available_ink()), "combined barrier lengths can exactly fill the budget")
	game.begin_sketch(Vector2(50,220))
	check(not game.drawing and game.sketch.is_empty(), "full budget blocks a new stroke until ink returns")
	activate(game, PackedVector2Array([Vector2(50,220), Vector2(150,220)]))
	check(game.barriers.size() == 2 and is_zero_approx(game.available_ink()), "release validation cannot bypass the shared budget")
	game.step_world(4.0)
	check(game.barriers.size() == 1 and is_equal_approx(game.available_ink(), 800), "waiting restores the expired barrier ink while other barriers remain")
	game.begin_sketch(Vector2(50,220))
	game.append_sketch_point(Vector2(900,220))
	check(game.drawing and is_equal_approx(Route.length_of(game.sketch), 800) and is_equal_approx(game.active_barrier_length() + Route.length_of(game.sketch), game.BUDGET), "drawing clamps to remaining shared ink")
	var cancel := InputEventMouseButton.new()
	cancel.button_index = MOUSE_BUTTON_RIGHT
	cancel.pressed = true
	game._input(cancel)
	check(not game.drawing and game.sketch.is_empty() and is_equal_approx(game.available_ink(), 800), "cancel frees pending ink without removing active barriers")
	game.begin_sketch(Vector2(50,220))
	game.append_sketch_point(Vector2(900,220))
	game.step_world(1.0)
	game.append_sketch_point(Vector2(850,500))
	check(game.barriers.is_empty() and is_equal_approx(Route.length_of(game.sketch), 1080), "ink returned during a stroke can extend the same sketch")
	game.finish_sketch()
	check(game.barriers.size() == 1 and is_equal_approx(game.barriers[0].life, 5.0) and is_equal_approx(game.available_ink(), 470), "barrier lifetime starts on release and charges only the finished stroke")
	game.start_round()
	activate(game, PackedVector2Array([Vector2(50,150), Vector2(850,150)]))
	activate(game, PackedVector2Array([Vector2(50,180), Vector2(790,180)]))
	game.begin_sketch(Vector2(50,220))
	check(not game.drawing and is_equal_approx(game.available_ink(), 10), "less than the minimum stroke length also requires waiting")
	game.step_world(5.0)
	check(game.barriers.is_empty() and is_equal_approx(game.available_ink(), game.BUDGET), "simultaneous expiry removes all barriers without skipping refunds")
	game.start_round()
	game.hazards.append(hazard(Vector2(200,200), Vector2(100,0), true))
	activate(game, line)
	game.state = "paused"
	game._physics_process(1.0)
	check(game.elapsed == 0.0 and game.hazards[0].pos == Vector2(200,200), "pause freezes simulation")
	check(is_equal_approx(game.hazards[0].recovery, game.UFO_RECOVERY_TIME), "pause freezes alien recovery timer")
	check(game.barriers.size() == 1 and is_equal_approx(game.barriers[0].life, 5.0) and is_equal_approx(game.available_ink(), 1320), "pause freezes barrier lifetime and ink refunds")
	game.start_round()
	check(game.hazards.is_empty() and game.barriers.is_empty() and game.health == 5 and game.score == 0, "restart clears barriers hazards and score")
	check(is_equal_approx(game.available_ink(), game.BUDGET), "restart restores the full ink budget")
	game.rng.seed = 1234
	for i in range(5400):
		if game.state != "playing":
			break
		game._physics_process(1.0 / 60.0)
	check(game.state == "lost", "unprotected planet loses in seeded simulation")
	print("Simulation ended: ", game.state, " at ", game.elapsed, " seconds")
	game.free()
	print("Checks: ", checks, "; failures: ", failures)
	quit(failures)
