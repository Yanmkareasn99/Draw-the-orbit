static func translate(value: String, language: String) -> String:
	if language not in ["ja", "vi"] or not TEXT.has(value):
		return value
	return TEXT[value][0 if language == "ja" else 1]

static func make_font(heavy: bool = false) -> Font:
	var weight_tag := TextServerManager.get_primary_interface().name_to_tag("wght")
	var axes := {weight_tag: 700.0 if heavy else 400.0}
	var japanese := FontVariation.new()
	japanese.base_font = JAPANESE
	japanese.variation_opentype = axes
	var latin := FontVariation.new()
	latin.base_font = LATIN
	latin.variation_opentype = axes
	latin.fallbacks = [japanese]
	return latin
